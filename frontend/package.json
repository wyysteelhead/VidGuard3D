{
  "name": "frontend",
  "version": "0.1.0",
  "scripts": {
    "reset": "npx rimraf ./**/node_modules",
    "dev": "modern dev",
    "build": "modern build",
    "start": "modern start",
    "serve": "modern serve",
    "new": "modern new",
    "lint": "modern lint",
    "prepare": "husky install",
    "upgrade": "modern upgrade"
  },
  "engines": {
    "node": ">=16.18.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "node --max_old_space_size=8192 ./node_modules/eslint/bin/eslint.js --fix --color --cache --quiet"
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "dist/"
  ],
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.2.3",
    "@modern-js/plugin-tailwindcss": "2.44.0",
    "@modern-js/runtime": "2.44.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "ahooks": "^3.7.10",
    "antd": "^5.12.6",
    "axios": "^1.6.3",
    "d3": "^7.8.5",
    "dotenv": "^16.4.5",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "react": "~18.2.0",
    "react-dom": "~18.2.0",
    "react-draggable": "^4.4.6",
    "react-resizable": "^3.0.5",
    "three": "^0.160.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@modern-js-app/eslint-config": "2.44.0",
    "@modern-js/app-tools": "2.44.0",
    "@modern-js/eslint-config": "2.44.0",
    "@modern-js/tsconfig": "2.44.0",
    "@types/echarts": "^4.9.22",
    "@types/jest": "~29.2.4",
    "@types/node": "~16.11.7",
    "@types/react": "~18.0.26",
    "@types/react-dom": "~18.0.10",
    "@types/three": "^0.168.0",
    "autoprefixer": "^10.4.18",
    "husky": "~8.0.1",
    "lint-staged": "~13.1.0",
    "postcss": "^8.4.35",
    "prettier": "~2.8.1",
    "rimraf": "~3.0.2",
    "tailwindcss": "~3.3.7",
    "typescript": "~5.0.4"
  }
}
